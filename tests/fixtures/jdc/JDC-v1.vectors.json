        "kind": "configuration",
        "message": "invalid configuration"
      },
      "expect": {
        "category": "configuration",
        "outcome": "not-started"
      }
    },
    {
      "id": "error-pool-timeout",
      "requirements": ["ERR-02", "POOL-03", "OUT-02"],
      "input": {
        "kind": "pool-timeout",
        "message": "pool acquire timed out"
      },
      "expect": {
        "category": "pool-timeout",
        "outcome": "not-started"
      }
    },
    {
      "id": "error-pool-exhausted",
      "requirements": ["ERR-02", "POOL-03", "OUT-02"],
      "input": {
        "kind": "pool-exhausted",
        "message": "pool waiter queue is full"
      },
      "expect": {
        "category": "pool-exhausted",
        "outcome": "not-started"
      }
    },
    {
      "id": "error-timeout",
      "requirements": ["ERR-02", "CAN-08", "OUT-04"],
      "input": {
        "kind": "timeout",
        "message": "command deadline expired"
      },
      "expect": {
        "category": "timeout",
        "outcome": "unknown"
      }
    },
    {
      "id": "error-server-response",
      "requirements": ["ERR-02", "ERR-03", "OUT-04"],
      "input": {
        "kind": "server-response",
        "message": "incomplete server diagnostic"
      },
      "expect": {
        "category": "server-response",
        "outcome": "unknown"
      }
