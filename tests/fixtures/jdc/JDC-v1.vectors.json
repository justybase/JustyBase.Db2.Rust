  "errors": [
    {
      "id": "error-sql-cancelled",
      "requirements": ["ERR-03", "ERR-04", "ERR-05", "ERR-06", "OUT-03", "OUT-09", "CAN-03"],
      "input": {
        "kind": "sql",
        "sql_code": -952,
        "sql_state": "57014",
        "message": "operation cancelled"
      },
      "expect": {
        "category": "operation-cancelled",
        "outcome": "confirmed",
        "sql_code": -952,
        "sql_state": "57014",
        "message_contains": ["SQLCODE=-952", "SQLSTATE=57014"]
      }
    },
    {
      "id": "error-sql-constraint",
