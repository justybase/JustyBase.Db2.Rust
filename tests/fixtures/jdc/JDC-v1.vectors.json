  "dsn": {
    "accept": [
      {
        "id": "dsn-url-basic",
        "requirements": ["DSN-01", "DSN-02"],
        "input": "db2://db2inst1:password@localhost:50000/SAMPLE",
        "expect": {
          "host": "localhost",
          "port": 50000,
          "database": "SAMPLE",
          "user": "db2inst1",
          "password": "password",
          "use_ssl": false,
          "timeout_ms": 30000,
          "block_size": 65535,
          "security_mechanism": 0,
          "current_schema": ""
        }
      },
      {
        "id": "dsn-url-tls",
        "requirements": ["DSN-01", "DSN-02", "DSN-06"],
        "input": "db2s://myuser:sec%40ret@db2server:50001/PRODDB?timeout=15s&block_size=131072",
        "expect": {
          "host": "db2server",
          "port": 50001,
          "database": "PRODDB",
          "user": "myuser",
          "password": "sec@ret",
          "use_ssl": true,
          "timeout_ms": 15000,
          "block_size": 131072
        }
      },
      {
        "id": "dsn-url-scheme-case",
        "requirements": ["DSN-01"],
        "input": "DB2://user:pass@host:50000/TESTDB",
        "expect": {
          "host": "host",
          "port": 50000,
          "database": "TESTDB",
          "user": "user",
          "password": "pass",
          "use_ssl": false
        }
      },
      {
        "id": "dsn-url-escaped-credentials",
        "requirements": ["DSN-01"],
        "input": "db2://us%40er:pa%40ss@host/TESTDB",
        "expect": {
          "user": "us@er",
          "password": "pa@ss"
        }
      },
      {
        "id": "dsn-url-ipv6",
        "requirements": ["DSN-01", "DSN-02"],
        "input": "db2://user:pass@[::1]:50000/TESTDB",
        "expect": {
          "host": "::1",
          "port": 50000
        }
      },
      {
        "id": "dsn-url-user-only",
        "requirements": ["DSN-01"],
        "input": "db2://user@host/TESTDB",
        "expect": {
          "user": "user",
          "password": ""
        }
      },
      {
        "id": "dsn-url-no-user",
        "requirements": ["DSN-01"],
        "input": "db2://host/TESTDB",
        "expect": {
          "user": "",
          "password": ""
        }
      },
      {
        "id": "dsn-url-timeout-unit",
        "requirements": ["DSN-01", "DSN-02"],
        "input": "db2://user:pass@host/TESTDB?timeout=5s",
        "expect": {
          "timeout_ms": 5000
        }
      },
      {
        "id": "dsn-url-timeout-seconds",
        "requirements": ["DSN-01", "DSN-02"],
        "input": "db2://user:pass@host/TESTDB?timeout=7",
        "expect": {
          "timeout_ms": 7000
        }
      },
      {
        "id": "dsn-url-timeout-compound",
        "requirements": ["DSN-01", "DSN-02"],
        "input": "db2://host/TESTDB?timeout=2m30s",
        "expect": {
          "timeout_ms": 150000
        }
      },
      {
        "id": "dsn-url-security-mechanism",
        "requirements": ["DSN-02", "DSN-04"],
        "input": "db2://user:pass@host/TESTDB?security_mechanism=9",
        "expect": {
          "security_mechanism": 9
        }
      },
      {
        "id": "dsn-url-block-size",
        "requirements": ["DSN-02"],
        "input": "db2://user:pass@host/TESTDB?block_size=131072",
        "expect": {
          "block_size": 131072
        }
      },
      {
        "id": "dsn-url-invalid-timeout-keeps-default",
        "requirements": ["DSN-01"],
        "input": "db2://u:p@host/TESTDB?timeout=abc",
        "expect": {
          "timeout_ms": 30000
        }
      },
      {
        "id": "dsn-url-invalid-port-key-keeps-default",
        "requirements": ["DSN-01", "DSN-02"],
        "input": "db2://u:p@host/TESTDB?port=70000",
        "expect": {
          "port": 50000
        }
      },
      {
        "id": "dsn-kv-aliases",
        "requirements": ["DSN-01", "DSN-02"],
        "input": "Database=TESTDB;Host=h;Port=50001;UID=u;PWD=p",
        "expect": {
          "host": "h",
          "port": 50001,
          "database": "TESTDB",
          "user": "u",
          "password": "p"
        }
      },
      {
        "id": "dsn-kv-case-insensitive",
        "requirements": ["DSN-01", "DSN-02"],
        "input": "DATABASE=TESTDB;HOST=h",
        "expect": {
          "host": "h",
          "database": "TESTDB"
        }
      },
      {
        "id": "dsn-kv-last-wins",
        "requirements": ["DSN-01"],
        "input": "Database=TESTDB;UID=a;UID=b",
        "expect": {
          "user": "b"
        }
      },
      {
        "id": "dsn-kv-password-contains-equals",
        "requirements": ["DSN-01"],
        "input": "Database=TESTDB;PWD=a=b",
        "expect": {
          "password": "a=b"
        }
      },
      {
        "id": "dsn-kv-server-endpoint",
        "requirements": ["DSN-02"],
        "input": "Server=host:50001;Database=TESTDB",
        "expect": {
          "host": "host",
          "port": 50001
        }
      },
      {
        "id": "dsn-kv-server-ipv6-endpoint",
        "requirements": ["DSN-02"],
        "input": "Server=[::1]:50001;Database=TESTDB",
        "expect": {
          "host": "::1",
          "port": 50001
        }
      },
      {
        "id": "dsn-kv-authentication-server-encrypt",
        "requirements": ["DSN-02", "DSN-05"],
        "input": "Database=TESTDB;Authentication=SERVER_ENCRYPT",
        "expect": {
          "security_mechanism": 9
        }
      },
      {
        "id": "dsn-kv-authentication-gssplugin",
        "requirements": ["DSN-02", "DSN-05"],
        "input": "Database=TESTDB;Authentication=GSSPLUGIN",
        "expect": {
          "security_mechanism": 11
        }
      },
      {
        "id": "dsn-kv-defaults",
        "requirements": ["DSN-01", "DSN-02"],
        "input": "Database=TESTDB",
        "expect": {
          "host": "localhost",
          "port": 50000,
          "database": "TESTDB",
          "user": "",
          "password": "",
          "use_ssl": false,
          "timeout_ms": 30000,
          "block_size": 65535,
          "security_mechanism": 0,
          "current_schema": ""
        }
      },
      {
        "id": "dsn-kv-current-schema",
        "requirements": ["DSN-02", "DSN-03"],
        "input": "Database=TESTDB;CurrentSchema=Sales",
        "expect": {
          "current_schema": "Sales"
        }
      },
      {
        "id": "dsn-kv-current-schema-trimmed",
        "requirements": ["DSN-03"],
        "input": "Database=TESTDB;CurrentSchema= Sales ",
        "expect": {
          "current_schema": "Sales"
        }
      },
      {
        "id": "dsn-kv-kerberos-aliases",
        "requirements": ["DSN-02"],
        "input": "Database=TESTDB;kerberos_spn=db2/server@REALM;kerberos_realm=REALM;krb5principal=user@REALM;krb5_config=/etc/krb5.conf;keytab=/tmp/db2.keytab;ccache=/tmp/cc;gssapi_token=/tmp/token.bin",
        "expect": {
          "kerberos_spn": "db2/server@REALM",
          "kerberos_realm": "REALM",
          "krb5_principal": "user@REALM",
          "krb5_config_file": "/etc/krb5.conf",
          "krb5_keytab_file": "/tmp/db2.keytab",
          "krb5_ccache_file": "/tmp/cc",
          "gssapi_token_file": "/tmp/token.bin"
        }
      },
      {
        "id": "dsn-url-kerberos-escaped",
        "requirements": ["DSN-01", "DSN-02"],
        "input": "db2://localhost/TESTDB?spn=db2%2Fserver@CORP.LOCAL&krb5_config=%2Fetc%2Fkrb5.conf&krb5_keytab=%2Fetc%2Fdb2.keytab&krb5_ccache=%2Ftmp%2Fkrb5cc_1000&client_applname=orders&client_corr_token=trace",
        "expect": {
          "kerberos_spn": "db2/server@CORP.LOCAL",
          "krb5_config_file": "/etc/krb5.conf",
          "krb5_keytab_file": "/etc/db2.keytab",
          "krb5_ccache_file": "/tmp/krb5cc_1000",
          "client_appl_name": "orders",
          "client_corr_token": "trace"
        }
      },
      {
        "id": "dsn-kv-unknown-option",
        "requirements": ["DSN-08"],
        "input": "Database=TESTDB;Unknown=1",
        "expect": {
          "params": {
            "Unknown": "1"
          }
        }
      },
      {
        "id": "dsn-kv-ssl-port",
        "requirements": ["DSN-02", "DSN-06"],
        "input": "Database=TESTDB;ssl=yes",
        "expect": {
          "use_ssl": true,
          "port": 50001
        }
      },
      {
        "id": "dsn-kv-ssl-explicit-port",
        "requirements": ["DSN-02", "DSN-06"],
        "input": "Database=TESTDB;ssl=yes;port=50000",
        "expect": {
          "use_ssl": true,
          "port": 50000
        }
      },
      {
        "id": "dsn-kv-ibm-tls",
        "requirements": ["DSN-02", "DSN-06"],
        "input": "Server=db.example.test:50001;Database=TEST;UID=user;PWD=secret;Security=SSL;SSLServerCertificate=/tmp/db2-ca.pem",
        "expect": {
          "host": "db.example.test",
          "port": 50001,
          "database": "TEST",
          "user": "user",
          "password": "secret",
          "use_ssl": true,
          "ssl_root_ca_path": "/tmp/db2-ca.pem"
        }
      }
